root = Card([header, gallery, intro, route, costs, followUps])
header = CardHeader("St. Naum Day Trip", "The springs of Lake Ohrid, a 10th-century monastery and a village on the water")
gallery = ImageGallery(@Each(photos.photos, "p", {src: p.image, alt: p.imageAlt, details: p.title + " · " + p.credit}))
photos = Query("find_photos", {topics: ["Monastery of Saint Naum", "Galičica National Park", "Lake Ohrid"], context: "Ohrid"}, {photos: []})
intro = TextContent("St. Naum is **29 km south** of Ohrid, near the Albanian border. Go early: the springs are calmest in the morning, and you can stop at the Bay of Bones on the way back.")
route = Steps([r1, r2, r3, r4, r5])
r1 = StepsItem("09:00 · Bus from Ohrid", "Buses to St. Naum leave from the bus station; the ride takes about 45 minutes.")
r2 = StepsItem("10:00 · Monastery of St. Naum", "See the 10th-century church and the peacocks in the courtyard.")
r3 = StepsItem("11:00 · Boat through the springs", "A rowing boat takes you through the springs that feed the lake, about 30 minutes.")
r4 = StepsItem("13:00 · Lunch by the water", "Restaurants line the shore below the monastery.")
r5 = StepsItem("15:00 · Bay of Bones", "Stop at Gradište on the way back for the **Bronze Age village** on the water.")
costs = EntityList([c1, c2, c3, c4], "default", {left: "Item", right: "Cost"}, {left: "Total", right: "€17", rightVariant: "number"})
c1 = {left: "Bus (return)", right: "€4", rightVariant: "number"}
c2 = {left: "Monastery", right: "€2", rightVariant: "number"}
c3 = {left: "Boat through the springs", right: "€8", rightVariant: "number"}
c4 = {left: "Bay of Bones", right: "€3", rightVariant: "number"}
followUps = FollowUpBlock([f1, f2])
f1 = FollowUpItem("Show me the top sights in Ohrid")
f2 = FollowUpItem("What's the weather like next week?")
