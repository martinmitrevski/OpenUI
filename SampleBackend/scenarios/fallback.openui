root = Card([header, intro, note, followUps])
header = CardHeader({{topic}}, "Demo mode")
intro = TextContent("The sample backend is running in **demo mode**, so it answers with scripted responses. Start it with an Anthropic API key to get live answers to anything you ask.")
note = TextCallout("info", "Try one of these", "Each suggestion shows different OpenUI components: live queries, forms, charts and more.")
followUps = FollowUpBlock([f1, f2, f3, f4])
f1 = FollowUpItem("Plan a 3-day trip to Ohrid")
f2 = FollowUpItem("Find hotels in Ohrid under €70")
f3 = FollowUpItem("What's the weather like next week?")
f4 = FollowUpItem("Give me a quick pasta recipe")
