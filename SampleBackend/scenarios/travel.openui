root = Card([header, hero, intro, stats, sightsHeader, sights, plan, budgetHeader, budget, hotelsHeader, hotelFilter, hotelTable, saveHeader, saveForm, saved, followUps], [src1, src2])
header = CardHeader("3 Days in Ohrid", "Byzantine churches, a hilltop fortress and one of Europe's oldest lakes")
cityPhoto = Query("find_photos", {topics: ["Ohrid"]}, {photos: []})
hero = ImageBlock(@First(cityPhoto.photos.image), "Ohrid and its lake")
intro = TextContent("Ohrid sits on the shore of **Lake Ohrid**, one of the oldest lakes in Europe, and its old town is a UNESCO World Heritage site [1]. Each day below keeps to one part of the lake, so you can do it all on foot and by local bus. Tap a stop for tips.")
stats = OverviewCardBlock([s1, s2, s3], "grid", true)
s1 = OverviewCardItem("budget", s1top, s1metric)
s1top = IconText(s1icon, "neutral", "m", "Budget", "per person", false, "vertical")
s1icon = Icon("wallet", "finance")
s1metric = MetricIndicatorInline("€340", "3 nights incl. stay")
s2 = OverviewCardItem("walking", s2top, s2metric)
s2top = IconText(s2icon, "neutral", "m", "Walking", "average per day", false, "vertical")
s2icon = Icon("footprints", "transportation")
s2metric = MetricIndicatorInline("7 km", "old-town hills")
s3 = OverviewCardItem("weather", s3top, s3metric)
s3top = IconText(s3icon, "neutral", "m", "Weather", "in October", false, "vertical")
s3icon = Icon("sun", "weather")
s3metric = MetricIndicatorInline("19°C", "cool evenings")
sightsHeader = InlineHeader("Top sights", "Tap a photo to ask about it")
sightPhotos = Query("find_photos", {topics: ["Church of St. John at Kaneo", "Samuel's Fortress", "Church of St. Sophia", "Plaošnik", "Monastery of Saint Naum"], context: "Ohrid"}, {photos: []})
sights = VisualCardBlock(@Each(sightPhotos.photos, "p", VisualCardItem(BoldText("text", p.title, p.description), p.topic, p.image, null, p.imageAlt)), "carousel", true, Action([@ToAssistant("Tell me more about this place in Ohrid")]))
plan = SectionBlock([day1, day2, day3])
day1 = SectionItem("day1", "Day 1 · Old town & Kaneo", [day1List])
day1List = ListBlock([d1a, d1b, d1c, d1d], "number")
d1a = ListItem("Old Bazaar & the Upper Gate", "Coffee on the Čaršija, then walk up through the old town", null, "Tips", Action([@ToAssistant("What should I see around Ohrid's Old Bazaar?")]))
d1b = ListItem("Church of St. Sophia", "11th-century frescoes; go before the tour groups arrive", null, "Tips", Action([@ToAssistant("Tell me about the Church of St. Sophia in Ohrid")]))
d1c = ListItem("Samuel's Fortress & the Ancient Theatre", "Walk the walls, then head down to the Hellenistic theatre", null, "Tips", Action([@ToAssistant("Is Samuel's Fortress worth visiting?")]))
d1d = ListItem("Sunset at Kaneo", "Plaošnik, then the cliff path to St. John at Kaneo", null, "Tips", Action([@ToAssistant("When is the best time to see St. John at Kaneo?")]))
day2 = SectionItem("day2", "Day 2 · The south shore", [day2Steps])
day2Steps = Steps([st1, st2, st3])
st1 = StepsItem("Bus toward St. Naum", "Local buses leave from the bus station; the Bay of Bones is about 30 minutes away.")
st2 = StepsItem("Bay of Bones", "A reconstructed Bronze Age village on wooden piles over the water. About **€3**.")
st3 = StepsItem("Monastery of St. Naum", "Peacocks, frescoes and a rowing boat through the springs that feed the lake.")
day3 = SectionItem("day3", "Day 3 · Lake & mountains", [day3List])
day3List = ListBlock([d3a, d3b, d3c], "number")
d3a = ListItem("A morning on the lake", "Kayak or take a taxi boat along the shore from the harbour", null, "Tips", Action([@ToAssistant("Where can I rent a kayak in Ohrid?")]))
d3b = ListItem("Galičica panorama road", "Viewpoints over Lake Ohrid and Lake Prespa at once", null, "Tips", Action([@ToAssistant("How do I get to the Galičica viewpoints?")]))
d3c = ListItem("Dinner in the old town", "Try tavče gravče and a glass of local Vranec", null, "Tips", Action([@ToAssistant("What should I eat in Ohrid?")]))
budgetHeader = InlineHeader("Where the money goes", "Estimated per person, in €")
budget = PieChart(["Stay", "Food", "Transport", "Activities"], [180, 90, 25, 45], "donut")
$maxPrice = "70"
hotels = Query("search_hotels", {city: "Ohrid", maxPrice: $maxPrice, sort: "rating"}, {city: "Ohrid", total: 0, hotels: []})
hotelsHeader = InlineHeader("Where to stay", "Live availability — change the budget to refresh")
hotelFilter = Form("hotel-filter", filterButtons, [priceField])
priceField = FormControl("Max price per night", Select("maxPrice", [p1, p2, p3, p4], "Any price", null, $maxPrice))
p1 = SelectItem("40", "Under €40")
p2 = SelectItem("70", "Under €70")
p3 = SelectItem("100", "Under €100")
p4 = SelectItem("150", "Under €150")
filterButtons = Buttons([refreshBtn])
refreshBtn = Button("Refresh prices", Action([@Run(hotels)]), "primary", "normal", "small")
hotelTable = Table([Col("Hotel", hotels.hotels.name), Col("Area", hotels.hotels.area), Col("€/night", hotels.hotels.price, "number"), Col("Rating", @Each(hotels.hotels, "h", Tag("★ " + h.rating, null, "sm", h.rating >= 4.7 ? "success" : "neutral")))])
saveHeader = InlineHeader("Save this plan", "We'll keep it in your trips")
$saved = false
save = Mutation("save_trip", {destination: "Ohrid", travelers: $travelers, budget: $budget})
saveForm = Form("trip", saveButtons, [travelersField, budgetField])
travelersField = FormControl("Travellers", Select("travelers", [t1, t2, t3], "How many?", {required: true}, $travelers))
t1 = SelectItem("1", "Just me")
t2 = SelectItem("2", "Two of us")
t3 = SelectItem("4", "Family of four")
budgetField = FormControl("Budget per person (€)", Slider("budget", "discrete", 200, 1000, 20, [340], "Budget", null, $budget), "Stay, food and activities")
saveButtons = Buttons([saveBtn])
saveBtn = Button("Save trip", Action([@Run(save), @Set($saved, true)]), "primary")
saved = Callout("success", "Trip saved", "" + save.data.message, $saved)
followUps = FollowUpBlock([f1, f2, f3, f4])
f1 = FollowUpItem("Find hotels in Ohrid under €70")
f2 = FollowUpItem("Show me the top sights in Ohrid")
f3 = FollowUpItem("Plan the St. Naum day trip in detail")
f4 = FollowUpItem("What's the weather like next week?")
src1 = {title: "Natural and Cultural Heritage of the Ohrid region", sourceName: "UNESCO World Heritage", url: "https://whc.unesco.org/en/list/99"}
src2 = {title: "Photos of Ohrid", sourceName: "Wikimedia Commons", url: "https://commons.wikimedia.org/wiki/Category:Ohrid"}
