root = Card([header, photo, intro, facts, tabs, added, followUps])
header = CardHeader("Spaghetti Carbonara", "Silky and Roman-style — 20 minutes, no cream")
dishPhoto = Query("find_photos", {topics: ["Spaghetti alla carbonara"]}, {photos: []})
photo = ImageBlock(@First(dishPhoto.photos.image), "Spaghetti carbonara")
intro = TextContent("The secret is **tempering the eggs** with starchy pasta water off the heat, so the sauce turns glossy instead of scrambled. Change the servings and the ingredient amounts update live.")
facts = SnippetCardBlock([time, level, kcal, serves])
time = SnippetCardItem("time", IconText(Icon("timer", "time"), "neutral", "s", "Total time"), BoldText("text", "20 min"))
level = SnippetCardItem("level", IconText(Icon("chef-hat", "food-beverage"), "neutral", "s", "Difficulty"), BoldText("text", "Easy"))
kcal = SnippetCardItem("kcal", IconText(Icon("flame", "food-beverage"), "warning", "s", "Per serving"), BoldText("number", "640 kcal"))
serves = SnippetCardItem("serves", IconText(Icon("users", "people"), "neutral", "s", "Serves"), BoldText("number", "" + ingredients.servings))
$servings = "2"
$added = false
ingredients = Query("scale_recipe", {recipe: "carbonara", servings: $servings}, {servings: 2, calories: 1280, ingredients: []})
addToList = Mutation("add_to_shopping_list", {recipe: "carbonara", servings: $servings})
tabs = Tabs([tabIngredients, tabSteps, tabNutrition])
tabIngredients = TabItem("ingredients", "Ingredients", [servingsForm, ingredientsTable])
servingsForm = Form("servings", listButtons, [servingsField])
servingsField = FormControl("Servings", Select("servings", [sv1, sv2, sv3, sv4], null, null, $servings))
sv1 = SelectItem("1", "1 person")
sv2 = SelectItem("2", "2 people")
sv3 = SelectItem("4", "4 people")
sv4 = SelectItem("6", "6 people")
listButtons = Buttons([Button("Add to shopping list", Action([@Run(addToList), @Set($added, true)]), "primary")])
ingredientsTable = Table([Col("Ingredient", ingredients.ingredients.item), Col("Amount", ingredients.ingredients.amount)])
tabSteps = TabItem("steps", "Steps", [steps])
steps = Steps([st1, st2, st3, st4, st5])
st1 = StepsItem("Crisp the guanciale", "Cook the strips in a cold pan over medium heat until golden, about 8 minutes. Keep the fat.")
st2 = StepsItem("Boil the pasta", "Salt the water generously and cook the spaghetti 1 minute short of al dente. **Save a mug of pasta water.**")
st3 = StepsItem("Make the sauce", "Whisk the yolks, whole egg, most of the pecorino and plenty of black pepper into a thick paste.")
st4 = StepsItem("Combine off the heat", "Toss the pasta with the guanciale, take the pan off the heat, then add the egg mixture with splashes of pasta water.")
st5 = StepsItem("Serve immediately", "Finish with the remaining pecorino and a final crack of pepper.")
tabNutrition = TabItem("nutrition", "Nutrition", [total, macros])
total = TextContent("Total for **" + ingredients.servings + "** servings: **" + ingredients.calories + " kcal**")
macros = PieChart(["Carbs", "Fat", "Protein"], [78, 32, 28], "donut")
added = Callout("success", "Added to your list", "" + addToList.data.message, $added)
followUps = FollowUpBlock([f1, f2])
f1 = FollowUpItem("Make it vegetarian")
f2 = FollowUpItem("Plan a 3-day trip to Ohrid")
