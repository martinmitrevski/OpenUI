root = Card([header, photo, intro, tabs, followUps])
header = CardHeader("Shakshuka", "Eggs poached in a spiced tomato and pepper sauce")
dishPhoto = Query("find_photos", {topics: ["Shakshuka"]}, {photos: []})
photo = ImageBlock(@First(dishPhoto.photos.image), "Shakshuka")
intro = TextContent("A one-pan, vegetarian swap that's ready in **25 minutes**. Serve it with crusty bread for dipping.")
$servings = "2"
ingredients = Query("scale_recipe", {recipe: "shakshuka", servings: $servings}, {servings: 2, calories: 760, ingredients: []})
tabs = Tabs([tabIngredients, tabSteps])
tabIngredients = TabItem("ingredients", "Ingredients", [servingsForm, ingredientsTable])
servingsForm = Form("servings", buttons, [servingsField])
servingsField = FormControl("Servings", Select("servings", [sv1, sv2, sv3], null, null, $servings))
sv1 = SelectItem("2", "2 people")
sv2 = SelectItem("4", "4 people")
sv3 = SelectItem("6", "6 people")
buttons = Buttons([Button("Update amounts", Action([@Run(ingredients)]), "primary", "normal", "small")])
ingredientsTable = Table([Col("Ingredient", ingredients.ingredients.item), Col("Amount", ingredients.ingredients.amount)])
tabSteps = TabItem("steps", "Steps", [steps])
steps = Steps([st1, st2, st3])
st1 = StepsItem("Build the sauce", "Soften the onion and pepper in olive oil, add cumin, then the tomatoes. Simmer 10 minutes.")
st2 = StepsItem("Poach the eggs", "Make small wells, crack in the eggs, cover and cook until the whites set.")
st3 = StepsItem("Finish", "Crumble over the feta and add fresh herbs.")
followUps = FollowUpBlock([f1])
f1 = FollowUpItem("Show me the carbonara recipe again")
