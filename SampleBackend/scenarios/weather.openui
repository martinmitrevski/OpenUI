root = Card([header, highlights, chart, daily, tip, followUps])
weather = Query("get_weather", {city: "Ohrid", days: 5}, {city: "Ohrid", days: []})
header = CardHeader("Ohrid · 5-day forecast", "Mild afternoons, cool evenings by the lake")
highlights = SnippetCardBlock([warmest, coolest, rain, sunny])
warmest = SnippetCardItem("warmest", IconText(Icon("thermometer", "weather"), "warning", "s", "Warmest"), BoldText("number", @Max(weather.days.high) + "°C"))
coolest = SnippetCardItem("coolest", IconText(Icon("moon", "weather"), "info", "s", "Coolest night"), BoldText("number", @Min(weather.days.low) + "°C"))
rain = SnippetCardItem("rain", IconText(Icon("cloud-rain", "weather"), "neutral", "s", "Rainy days"), BoldText("number", "" + @Count(@Filter(weather.days, "rainChance", ">=", 50))))
sunny = SnippetCardItem("sunny", IconText(Icon("sun", "weather"), "success", "s", "Sunny days"), BoldText("number", "" + @Count(@Filter(weather.days, "condition", "==", "Sunny"))))
chart = LineChart(weather.days.day, [Series("High", weather.days.high), Series("Low", weather.days.low)], "natural", null, "°C")
daily = Table([Col("Day", weather.days.day), Col("Conditions", weather.days.condition), Col("High °C", weather.days.high, "number"), Col("Low °C", weather.days.low, "number"), Col("Rain %", weather.days.rainChance, "number")])
tip = TextCallout("info", "Packing tip", "Evenings by the lake get cool in October, so pack a warm layer, plus comfortable shoes for the old town's steep lanes.")
followUps = FollowUpBlock([f1, f2])
f1 = FollowUpItem("Plan a 3-day trip to Ohrid")
f2 = FollowUpItem("Find hotels in Ohrid under €70")
