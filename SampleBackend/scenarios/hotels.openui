root = Card([header, intro, filters, summary, picks, tableHeader, table, followUps])
header = CardHeader("Hotels in Ohrid", "Live prices from the hotel search tool")
intro = TextContent("Pick a budget and sort order — the list updates instantly. Tap **Ask** on a hotel to learn more about it.")
$maxPrice = "70"
$sort = "price"
hotels = Query("search_hotels", {city: "Ohrid", maxPrice: $maxPrice, sort: $sort}, {city: "Ohrid", total: 0, hotels: []})
filters = Form("hotel-search", filterButtons, [priceField, sortField])
priceField = FormControl("Max price per night", Select("maxPrice", [p1, p2, p3, p4], "Any price", null, $maxPrice))
p1 = SelectItem("40", "Under €40")
p2 = SelectItem("70", "Under €70")
p3 = SelectItem("100", "Under €100")
p4 = SelectItem("150", "Under €150")
sortField = FormControl("Sort by", Select("sort", [o1, o2], null, null, $sort))
o1 = SelectItem("price", "Lowest price")
o2 = SelectItem("rating", "Best rated")
filterButtons = Buttons([Button("Refresh prices", Action([@Run(hotels)]), "primary", "normal", "small")])
summary = TextContent("**" + hotels.total + "** hotels under €" + $maxPrice + " · from **€" + @Min(hotels.hotels.price) + "** per night", "small")
picks = CompositeCardBlock(@Each(hotels.hotels, "h", CompositeCardItem(h.id, IconText(Icon("bed-double", "travel"), "neutral", "m", h.name, h.area, true), [Text("text", h.highlight), TagBlock(["★ " + h.rating, h.area])], {price: BoldText("number", "€" + h.price, "per night"), button: Button("Ask", Action([@ToAssistant("Tell me more about " + h.name)]), "secondary")})), "carousel")
tableHeader = InlineHeader("Compare", "Sorted by your choice")
table = Table([Col("Hotel", hotels.hotels.name), Col("Area", hotels.hotels.area), Col("€/night", hotels.hotels.price, "number"), Col("Rating", hotels.hotels.rating, "number")])
followUps = FollowUpBlock([f1, f2])
f1 = FollowUpItem("Plan a 3-day trip to Ohrid")
f2 = FollowUpItem("Show me the top sights in Ohrid")
